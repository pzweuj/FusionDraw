{
  "name": "fusionview",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "vite --config apps/demo/vite.config.ts",
    "build": "tsc -b && vite build --config apps/demo/vite.config.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run && pnpm test:annotation",
    "test:annotation": "python3 -m unittest discover -s annotation-builder -p \"test_*.py\" || python -m unittest discover -s annotation-builder -p \"test_*.py\"",
    "build:annotation": "python3 annotation-builder/build_annotation.py || python annotation-builder/build_annotation.py"
  },
  "workspaces": ["apps/*", "packages/*"],
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
